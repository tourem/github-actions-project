<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.larbotech</groupId>
        <artifactId>github-actions-project</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>task-batch</artifactId>
    <packaging>jar</packaging>
    <name>Task Batch</name>
    <description>Batch planifié pour créer des tâches automatiquement</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>task-batch</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.larbotech.taskbatch.TaskBatchApplication</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <!-- Assembly pour la distribution complète -->
                    <execution>
                        <id>make-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/distribution.xml</descriptor>
                            </descriptors>
                            <finalName>task-batch-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>true</attach>
                        </configuration>
                    </execution>
                    <!-- Assembly pour la configuration DEV -->
                    <execution>
                        <id>make-conf-dev</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/conf-dev.xml</descriptor>
                            </descriptors>
                            <finalName>task-batch-${project.version}</finalName>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                        </configuration>
                    </execution>
                    <!-- Assembly pour la configuration HML -->
                    <execution>
                        <id>make-conf-hml</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/conf-hml.xml</descriptor>
                            </descriptors>
                            <finalName>task-batch-${project.version}</finalName>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                        </configuration>
                    </execution>
                    <!-- Assembly pour la configuration PRD -->
                    <execution>
                        <id>make-conf-prd</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/conf-prd.xml</descriptor>
                            </descriptors>
                            <finalName>task-batch-${project.version}</finalName>
                            <appendAssemblyId>true</appendAssemblyId>
                            <attach>true</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>attach-distribution</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <!-- Distribution complète -->
                                <artifact>
                                    <file>${project.build.directory}/task-batch-${project.version}.zip</file>
                                    <type>zip</type>
                                    <classifier>distribution</classifier>
                                </artifact>
                                <!-- Configuration DEV -->
                                <artifact>
                                    <file>${project.build.directory}/task-batch-${project.version}-conf-dev.zip</file>
                                    <type>zip</type>
                                    <classifier>conf-dev</classifier>
                                </artifact>
                                <!-- Configuration HML -->
                                <artifact>
                                    <file>${project.build.directory}/task-batch-${project.version}-conf-hml.zip</file>
                                    <type>zip</type>
                                    <classifier>conf-hml</classifier>
                                </artifact>
                                <!-- Configuration PRD -->
                                <artifact>
                                    <file>${project.build.directory}/task-batch-${project.version}-conf-prd.zip</file>
                                    <type>zip</type>
                                    <classifier>conf-prd</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

